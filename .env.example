# Copie para .env; nunca envie este arquivo para um repositorio publico.
PORT=3000
NODE_ENV=development
ADMIN_PASSWORD=troque-por-uma-senha-forte
COOKIE_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres
# Endereco HTTPS publico do portal (obrigatorio para publicar no Instagram)
PUBLIC_URL=https://seu-dominio.com.br
# Criar app no Meta for Developers, Instagram Login, permissoes
# instagram_business_basic + instagram_business_content_publish
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v25.0
# Em producao com disco do Render, configure STORAGE_DIR com o mount path do disco.
STORAGE_DIR=./storage
TRUST_PROXY=0
